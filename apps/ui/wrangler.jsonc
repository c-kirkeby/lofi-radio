{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "ui",
    "compatibility_date": "2026-04-29",
    "observability": {
      "enabled": true
    },
    "main": ".svelte-kit/cloudflare/_worker.js",
    "assets": {
      "binding": "ASSETS",
      "directory": ".svelte-kit/cloudflare"
    },
    "compatibility_flags": [
      "nodejs_compat"
    ]
  }
